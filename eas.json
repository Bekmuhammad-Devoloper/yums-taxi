{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.yums.uz/api/v1"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.yums.uz/api/v1"
      }
    },
    "driver-development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "driver"
      }
    },
    "driver-preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "driver",
        "EXPO_PUBLIC_API_URL": "https://api.yums.uz/api/v1"
      }
    },
    "driver-production": {
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "driver",
        "EXPO_PUBLIC_API_URL": "https://api.yums.uz/api/v1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
