{
  "expo": {
    "name": "YUMS Taxi",
    "slug": "yums-taxi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "yumstaxi",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "uz.yums.taxi",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "YUMS Taxi sizni qayerdan olib ketishni aniqlash uchun joylashuvingizdan foydalanadi."
      }
    },
    "android": {
      "package": "uz.yums.taxi",
      "adaptiveIcon": {
        "backgroundColor": "#FFC800",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "YUMS Taxi sizni qayerdan olib ketishni aniqlash uchun joylashuvingizdan foydalanadi."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFC800",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
